<query id="updateGuestUploadKey" action="update">
    <tables>
        <table name="files" />
    </tables>
    <columns>
        <column name="guest_upload_key" var="guest_upload_key" notnull="notnull" />
    </columns>
    <conditions>
        <condition operation="equal" column="file_srl" var="file_srl" filter="number" notnull="notnull" />
        <condition operation="equal" column="module_srl" var="module_srl" filter="number" notnull="notnull" pipe="and" />
        <condition operation="equal" column="upload_target_srl" var="upload_target_srl" filter="number" notnull="notnull" pipe="and" />
        <condition operation="equal" column="member_srl" default="0" pipe="and" />
        <condition operation="equal" column="isvalid" default="N" pipe="and" />
    </conditions>
</query>
